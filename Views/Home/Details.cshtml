@model CarDealerApp.Models.Car

<div class="row">
    <div class="col-md-6">
        <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Make @Model.Model" />
        <h2 class="mt-3">@Model.Year @Model.Make @Model.Model</h2>
        <h3 class="text-success">$@Model.Price.ToString("N0")</h3>
        <p class="lead">@Model.Description</p>
    </div>

    <div class="col-md-6">
        <div class="card p-4 shadow-sm">
            <h4>Inquire About This Car</h4>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <form asp-action="SubmitInquiry" method="post">
                <input type="hidden" name="CarId" value="@Model.Id" />
                
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input name="CustomerName" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input name="CustomerEmail" type="email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Message</label>
                    <textarea name="Message" class="form-control" rows="4" placeholder="I am interested in this vehicle..." required></textarea>
                </div>

                <button type="submit" class="btn btn-success w-100">Send Inquiry</button>
            </form>
        </div>
    </div>
</div>