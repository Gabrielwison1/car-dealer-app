@model IEnumerable<CarDealerApp.Models.Car>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Admin Dashboard — Vehicle Inventory</h2>
    <a asp-action="Create" class="btn btn-success">+ Upload New Car</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No vehicles in the inventory yet. Click <strong>Upload New Car</strong> to add one.</div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Image</th>
                <th>Make</th>
                <th>Model</th>
                <th>Year</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var car in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(car.ImagePath))
                        {
                            <img src="@car.ImagePath" style="width:80px; height:55px; object-fit:cover; border-radius:6px;" alt="@car.Make @car.Model" />
                        }
                        else
                        {
                            <span class="text-muted small">No image</span>
                        }
                    </td>
                    <td>@car.Make</td>
                    <td>@car.Model</td>
                    <td>@car.Year</td>
                    <td>$@car.Price.ToString("N0")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-outline-primary me-1">✏️ Edit</a>
                        <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-outline-danger">🗑️ Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}