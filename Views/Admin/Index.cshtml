@model IEnumerable<CarDealerApp.Models.Car>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Admin Dashboard - Vehicle Inventory</h2>
    <a asp-action="Create" class="btn btn-success">+ Upload New Car</a>
</div>

<table class="table table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Image</th>
            <th>Make</th>
            <th>Model</th>
            <th>Year</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var car in Model)
        {
            <tr>
                <td><img src="@car.ImageUrl" style="width:70px; height:50px; object-fit:cover;" /></td>
                <td>@car.Make</td>
                <td>@car.Model</td>
                <td>@car.Year</td>
                <td>$@car.Price.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>